# Talha_AI_RFunction_Assignment.R
# BDA400 / Data Science Tools and Techniques
# Assignment 3: Prompting R Functions with AI
#
# AI Assistance Declaration: I used ChatGPT (GPT-4o) on 2026-10-03 for
# ideation, drafting and explaining an R function, and suggesting tests.
# Prompts used:
# (1) "Write an R function that identifies outliers in a numeric vector
#      using the 1.5*IQR rule and returns the outlier values and their
#      positions."
# (2) "Revise the function to include comments, argument validation, and
#      return a clean result."
# (3) "Explain what each line of the R code does and how you might test
#      if it works correctly."
# (4) "Update the function to handle NA values and edge cases."
# (5) "Optimize the function for efficiency and readability."
# (6) "Summarize how this R function changed across revisions."
# (7) "Highlight what improvements were human-driven vs. AI-generated."
# I verified outputs using a primary calculation in Sheets, an independent
# R cross-check with boxplot.stats(), and a self spot-check. All final
# calculations are done by myself. I am responsible for the accuracy and
# originality of this work.
# ---------------------------------------------------------------------------
# Step 1: Task description
# Identify outliers in a numeric vector using Tukey's 1.5 x IQR rule,
# ignoring missing values by default and returning the outlier values,
# their original positions, and the calculated fences.
# ---------------------------------------------------------------------------
# --- Initial AI-generated function (kept for comparison) -------------------
find_outliers_initial <- function(x) {
q1 <- quantile(x, 0.25)
q3 <- quantile(x, 0.75)
iqr_value <- q3 - q1
x[x < q1 - 1.5 * iqr_value | x > q3 + 1.5 * iqr_value]
}
# --- Final refined function ------------------------------------------------
find_outliers <- function(x, na.rm = TRUE, multiplier = 1.5) {
if (!is.numeric(x) || !is.null(dim(x))) {
stop("'x' must be a numeric vector.", call. = FALSE)
}
if (length(multiplier) != 1L || !is.numeric(multiplier) ||
is.na(multiplier) || !is.finite(multiplier) || multiplier < 0) {
stop("'multiplier' must be one finite, non-negative number.", call. = FALSE)
}
if (length(na.rm) != 1L || !is.logical(na.rm) || is.na(na.rm)) {
stop("'na.rm' must be TRUE or FALSE.", call. = FALSE)
}
if (na.rm) {
keep <- !is.na(x)
} else {
if (anyNA(x)) {
stop("Missing values found; set na.rm = TRUE to ignore them.", call. = FALSE)
}
keep <- rep(TRUE, length(x))
}
original_positions <- which(keep)
clean_x <- x[keep]
if (length(clean_x) == 0L) {
stop("'x' must contain at least one usable value.", call. = FALSE)
}
if (any(!is.finite(clean_x))) {
stop("'x' must contain only finite values (or NA when na.rm = TRUE).",
call. = FALSE)
}
quartiles <- stats::quantile(clean_x, probs = c(0.25, 0.75), names = FALSE)
q1 <- quartiles[1L]
q3 <- quartiles[2L]
iqr_value <- q3 - q1
lower_fence <- q1 - multiplier * iqr_value
upper_fence <- q3 + multiplier * iqr_value
outlier_index <- which(clean_x < lower_fence | clean_x > upper_fence)
list(
outliers      = clean_x[outlier_index],
positions     = original_positions[outlier_index],
q1            = q1,
q3            = q3,
iqr           = iqr_value,
lower_fence   = lower_fence,
upper_fence   = upper_fence,
n_used        = length(clean_x),
n_outliers    = length(outlier_index)
)
}
# ---------------------------------------------------------------------------
# Step 2: Test and debug
# ---------------------------------------------------------------------------
cat("\n=== TEST 1: sample data (upper + lower outlier + NA) ===\n")
# FIXED: added -50 to exercise the LOWER fence as well.
sample_data <- c(-50, 10, 15, 20, 25, 30, 35, 100, NA)
result <- find_outliers(sample_data)
print(result)
cat("\n=== TEST 2: no-outlier case ===\n")
no_outlier_result <- find_outliers(c(1, 2, 3, 4, 5))
cat("n_outliers =", no_outlier_result$n_outliers, "(expected 0)\n")
stopifnot(no_outlier_result$n_outliers == 0L)
cat("\n=== TEST 3: NA handling with na.rm = TRUE ===\n")
# FIXED: explicit, correct assertion (previous %in% test was wrong).
na_vec <- c(1, NA, 2, 3, 100)
na_result <- find_outliers(na_vec)
print(na_result)
stopifnot(identical(na_result$outliers, 100))
stopifnot(identical(na_result$positions, 5L))
cat("\n=== TEST 4: NA present and na.rm = FALSE -> intentional error ===\n")
na_error <- try(find_outliers(c(1, NA, 2), na.rm = FALSE), silent = TRUE)
cat("Error message:", attr(na_error, "condition")$message, "\n")
stopifnot(inherits(na_error, "try-error"))
cat("\n=== TEST 5: non-numeric input -> intentional error ===\n")
type_error <- try(find_outliers(c("a", "b")), silent = TRUE)
cat("Error message:", attr(type_error, "condition")$message, "\n")
stopifnot(inherits(type_error, "try-error"))
cat("\n=== TEST 6: zero-IQR case (20 should be flagged) ===\n")
# FIXED: strong assertion instead of ">= 0".
zero_iqr_result <- find_outliers(c(5, 5, 5, 5, 5, 20))
cat("n_outliers =", zero_iqr_result$n_outliers, "(expected 1)\n")
stopifnot(zero_iqr_result$n_outliers == 1L)
cat("\n=== TEST 7: independent cross-check vs boxplot.stats() ===\n")
clean_sample <- sample_data[!is.na(sample_data)]
bb_out <- boxplot.stats(clean_sample)$out
cat("find_outliers()  :", result$outliers, "\n")
cat("boxplot.stats()  :", bb_out, "\n")
cat("Match:", setequal(result$outliers, bb_out), "\n")
cat("\n=== ALL TESTS COMPLETED ===\n")
