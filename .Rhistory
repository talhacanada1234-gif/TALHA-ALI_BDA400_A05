# Talha_AI_RFunction_Assignment.R
# BDA400 / Data Science Tools and Techniques
# Assignment 3: Prompting R Functions with AI
#
# AI Assistance Declaration: I used ChatGPT (GPT-5.6 Luna) for ideation,
# drafting and explaining an R function, and suggesting tests. Prompts used:
# (1) "Write an R function that identifies outliers in a numeric vector using
# the 1.5*IQR rule and returns the outlier values and their positions."
# (2) "Revise the function to include comments, argument validation, and
# return a clean result."
# (3) "Explain what each line of the R code does and how you might test if
# it works correctly."
# (4) "Update the function to handle NA values and edge cases."
# (5) "Optimize the function for efficiency and readability."
# I must run and verify the code in RStudio and complete the required
# spreadsheet, independent cross-check, and self spot-check before submission.
# All final calculations are to be completed and verified by me.
# ---------------------------------------------------------------------------
# Step 1: Task description
# Identify outliers in a numeric vector using Tukey's 1.5 × IQR rule.
# Missing values are ignored by default; the function returns a clean list
# containing the outlier values, their original positions, and the fences.
# ---------------------------------------------------------------------------
# Initial AI-generated function (kept for comparison; basic version).
# It calculates quartiles and flags values outside the 1.5 × IQR fences.
find_outliers_initial <- function(x) {
q1 <- quantile(x, 0.25)
q3 <- quantile(x, 0.75)
iqr_value <- q3 - q1
x[x < q1 - 1.5 * iqr_value | x > q3 + 1.5 * iqr_value]
}
# ---------------------------------------------------------------------------
# Final refined function
# ---------------------------------------------------------------------------
find_outliers <- function(x, na.rm = TRUE, multiplier = 1.5) {
# Require a numeric vector; matrices, data frames, and lists are not accepted.
if (!is.numeric(x) || !is.null(dim(x))) {
stop("'x' must be a numeric vector.", call. = FALSE)
}
# Require one non-missing, finite, non-negative multiplier.
if (length(multiplier) != 1L || !is.numeric(multiplier) ||
is.na(multiplier) || !is.finite(multiplier) || multiplier < 0) {
stop("'multiplier' must be one finite, non-negative number.", call. = FALSE)
}
# Require na.rm to be a single TRUE/FALSE value.
if (length(na.rm) != 1L || !is.logical(na.rm) || is.na(na.rm)) {
stop("'na.rm' must be TRUE or FALSE.", call. = FALSE)
}
# When requested, remove missing values while preserving original positions.
if (na.rm) {
keep <- !is.na(x)
} else {
# If missing values are present and removal is disabled, stop clearly.
if (anyNA(x)) {
stop("Missing values found; set na.rm = TRUE to ignore them.", call. = FALSE)
}
keep <- rep(TRUE, length(x))
}
# Record positions in the original vector and retain the corresponding data.
original_positions <- which(keep)
clean_x <- x[keep]
# Reject empty input after optional missing-value removal.
if (length(clean_x) == 0L) {
stop("'x' must contain at least one usable value.", call. = FALSE)
}
# Reject infinite values because quartiles and fences should be finite.
if (any(!is.finite(clean_x))) {
stop("'x' must contain only finite values (or NA when na.rm = TRUE).",
call. = FALSE)
}
# Calculate the first and third quartiles using R's default quantile method.
quartiles <- stats::quantile(clean_x, probs = c(0.25, 0.75), names = FALSE)
q1 <- quartiles[1L]
q3 <- quartiles[2L]
# Calculate the interquartile range and the lower and upper fences.
iqr_value <- q3 - q1
lower_fence <- q1 - multiplier * iqr_value
upper_fence <- q3 + multiplier * iqr_value
# Identify outliers in the cleaned vector, then map them to original positions.
outlier_index <- which(clean_x < lower_fence | clean_x > upper_fence)
# Return a consistently structured result, including an empty result if needed.
list(
outliers = clean_x[outlier_index],
positions = original_positions[outlier_index],
q1 = q1,
q3 = q3,
iqr = iqr_value,
lower_fence = lower_fence,
upper_fence = upper_fence,
n_used = length(clean_x),
n_outliers = length(outlier_index)
)
}
# ---------------------------------------------------------------------------
# Line-by-line explanation (the numbered comments map to the final function)
# ---------------------------------------------------------------------------
# 1. The function accepts a numeric vector, an NA-removal option, and a
#    non-negative fence multiplier.
# 2. The first validation prevents unsupported input types and dimensional data.
# 3. The multiplier validation prevents invalid or ambiguous fence settings.
# 4. The na.rm validation ensures the option is exactly one logical value.
# 5. If na.rm is TRUE, missing observations are excluded; otherwise their
#    presence triggers a clear error.
# 6. Original positions are saved so results refer to the supplied vector.
# 7. Empty usable input and non-finite values are rejected with readable errors.
# 8. The 25th and 75th percentiles are calculated with stats::quantile().
# 9. IQR is Q3 − Q1; fences are Q1 − multiplier×IQR and Q3 + multiplier×IQR.
# 10. Values strictly below or above the fences are flagged; fence values
#     themselves are not outliers.
# 11. The returned list includes outlier values, original indices, quartiles,
#     IQR, fences, and counts for inspection and downstream use.
# ---------------------------------------------------------------------------
# Step 2: Test and debug
# ---------------------------------------------------------------------------
# Synthetic data only, as required by the assignment.
sample_data <- c(10, 15, 20, 25, 30, 35, 100, NA)
# Run the function and print the full result for a console-output record.
result <- find_outliers(sample_data)
print(result)
# Edge-case checks: no outlier, missing-value behavior, and invalid inputs.
no_outlier_result <- find_outliers(c(1, 2, 3, 4, 5))
stopifnot(no_outlier_result$n_outliers == 0L)
na_result <- find_outliers(c(1, NA, 2, 3, 100))
stopifnot(identical(na_result$positions, which(c(1, NA, 2, 3, 100) %in%
na_result$outliers)))
# With na.rm = FALSE, missing data should produce an intentional error.
na_error <- try(find_outliers(c(1, NA, 2), na.rm = FALSE), silent = TRUE)
stopifnot(inherits(na_error, "try-error"))
# Non-numeric input should be rejected.
type_error <- try(find_outliers(c("a", "b")), silent = TRUE)
stopifnot(inherits(type_error, "try-error"))
# A zero IQR dataset has no values beyond its fences unless a value differs.
zero_iqr_result <- find_outliers(c(5, 5, 5, 5, 5, 20))
stopifnot(is.list(zero_iqr_result), zero_iqr_result$n_outliers >= 0L)
# Independent cross-check to perform in RStudio:
# boxplot.stats(sample_data[!is.na(sample_data)])$out
# Compare those values with result$outliers. Note that both use Tukey-style
# fences, but quantile conventions can differ for some small samples.
#
# Verification pattern required by the assignment:
# 1) Primary calculation in Sheets: enter the synthetic values, calculate Q1,
#    Q3, IQR, and fences, then identify values outside the fences.
# 2) Independent cross-check: compare with boxplot.stats() in R.
# 3) Self spot-check: inspect returned positions and manually confirm the
#    flagged value(s) against the original vector.
#
# IMPORTANT: Run this script in RStudio Desktop, inspect the console output,
# and save a screenshot or output log after completing the verification steps.
# This file contains runnable tests, not a claim that those tests were executed.
read.csv("sales_data_dirty.csv")
read.csv("sales_data_dirty.csv")
source("~/.active-rstudio-document")
source("~/.active-rstudio-document")
source("~/.active-rstudio-document")
source("~/.active-rstudio-document")
